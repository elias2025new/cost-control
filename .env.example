# ==============================================================================
# Prime Hospitality F&B Cost Control ERP — Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Connection (PostgreSQL Production / Local Development)
# ------------------------------------------------------------------------------
# In development, leave DATABASE_URL unset to run embedded PGlite (WASM Postgres in .pgdata).
# For production (Supabase, Neon, AWS RDS, Docker, or On-Premise PostgreSQL), specify your connection URI:

# Supabase Example (Transaction Pooler - Recommended):
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require"

# Neon Serverless Postgres Example:
# DATABASE_URL="postgresql://[USER]:[PASSWORD]@[ENDPOINT].neon.tech/neondb?sslmode=require"

# On-Premise / Local Dedicated PostgreSQL Example:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/prime_cost_control"

DATABASE_URL=

# ------------------------------------------------------------------------------
# 2. Authentication & Session Security
# ------------------------------------------------------------------------------
# In multi-instance or serverless deployments (Vercel, Docker clusters, Railway),
# provide a persistent 32-byte secret (or random 64-char hex string) to sign session cookies.
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ------------------------------------------------------------------------------
# 3. Application Server Settings
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
