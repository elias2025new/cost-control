{
  "name": "prime-fnb-cost-control",
  "version": "0.1.0",
  "private": true,
  "description": "F&B cost control for Prime Hospitality Business Group, Addis Ababa",
  "type": "module",
  "scripts": {
    "db:migrate": "tsx db/seed/migrate-cli.ts",
    "db:seed": "tsx db/seed/seed.ts",
    "db:reset": "tsx db/seed/seed.ts --reset",
    "db:bare": "tsx db/seed/seed.ts --reset --bare",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "coverage:curve": "tsx scripts/coverage-curve.ts",
    "demo:import": "tsx scripts/demo-import.ts",
    "demo:drive": "node scripts/drive-demo.mjs",
    "db:check": "tsx scripts/check-db.ts",
    "demo": "next build && next start"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "decimal.js": "^10.6.0",
    "lucide-react": "^1.47.0",
    "next": "^16.3.0",
    "next-themes": "^0.4.6",
    "pg": "^8.22.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
